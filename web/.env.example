# Copy to .env for local work. Set the same variables in Cloudflare Pages
# (Settings > Environment variables) for preview and production builds.
# Nothing here is a secret: every value ends up in the public site.

# Brand placeholders (not final: docs/02-decisions-log.md P22, E2).
SITE_NAME="Couples App"
SITE_COMPANY="[Company name] LLC"
SITE_DOMAIN="example.com"
# Optional. Default to support@, privacy@ and press@ on SITE_DOMAIN.
SITE_SUPPORT_EMAIL=
SITE_PRIVACY_EMAIL=
SITE_PRESS_EMAIL=

# Launch state. "false" shows the waitlist; "true" shows store badges.
SITE_LAUNCHED="false"
APP_STORE_URL=
GOOGLE_PLAY_URL=

# Deep links. Team ID comes from the Apple developer account (not available yet).
APPLE_TEAM_ID="TEAMID0000"
IOS_BUNDLE_ID="com.example.couplesapp"

# Waitlist: URL of the waitlist_join Edge Function, for example
# https://<project-ref>.supabase.co/functions/v1/waitlist_join
# Local test double: run `npm run mock:waitlist` and use http://127.0.0.1:8787/waitlist_join
PUBLIC_WAITLIST_ENDPOINT=
# Supabase anon key (public by design). Only needed if the function verifies JWTs.
PUBLIC_SUPABASE_ANON_KEY=

# Web approval for partners without the app (not built on the backend yet).
PUBLIC_APPROVE_ENDPOINT=
