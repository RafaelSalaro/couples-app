---
import Logo from './Logo.astro';
import { headerNav } from '../config/nav';
import { site } from '../config/site';

const current = Astro.url.pathname;
const cta = site.launched && site.appStoreUrl
  ? { href: site.appStoreUrl, label: 'Get the app' }
  : { href: '/#waitlist', label: 'Join the waitlist' };
---

<header class="site-header">
  <div class="wrap site-header__row">
    <a class="site-header__home" href="/" aria-label={`${site.name} home`}>
      <Logo />
    </a>
    <nav class="site-header__nav" aria-label="Main">
      <ul>
        {
          headerNav.map((item) => (
            <li>
              <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="button site-header__cta" href={cta.href}>{cta.label}</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    flex-wrap: wrap;
    padding-block: var(--space-2);
  }
  .site-header__home {
    text-decoration: none;
    margin-right: auto;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
  .site-header__nav ul {
    display: flex;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }
  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    background: var(--surface-sunken);
  }
  .site-header__cta {
    min-height: 44px;
    padding: 0 var(--space-4);
    font-size: 15px;
  }
  @media (max-width: 759px) {
    .site-header__nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--space-3));
    }
  }
</style>
