---
// Floating header: a glass pill with the logo, navigation, theme switch and call to action.
// On phones the navigation moves to a second pill at the bottom of the screen, in thumb reach.
import Logo from './Logo.astro';
import { headerNav } from '../config/nav';
import { site } from '../config/site';

const current = Astro.url.pathname;
const cta = site.launched && site.appStoreUrl
  ? { href: site.appStoreUrl, label: 'Get the app' }
  : { href: '/#waitlist', label: 'Join the waitlist' };
---

<header class="site-header">
  <div class="site-header__pill">
    <a class="site-header__home" href="/" aria-label={`${site.name} home`}>
      <Logo />
    </a>
    <nav class="site-header__nav" aria-label="Main">
      <ul>
        {
          headerNav.map((item) => (
            <li>
              <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
      <svg viewBox="0 0 32 32" width="24" height="24" aria-hidden="true">
        <mask id="theme-toggle-mask">
          <rect width="32" height="32" fill="#fff"></rect>
          <circle class="theme-toggle__cut" cx="16" cy="16" r="9" fill="#000"></circle>
        </mask>
        <g class="theme-toggle__rays" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M16 2.5v3M16 26.5v3M2.5 16h3M26.5 16h3M6.5 6.5l2.1 2.1M23.4 23.4l2.1 2.1M6.5 25.5l2.1-2.1M23.4 8.6l2.1-2.1"
          ></path>
        </g>
        <circle class="theme-toggle__disc" cx="16" cy="16" r="7" fill="currentColor" mask="url(#theme-toggle-mask)"
        ></circle>
      </svg>
    </button>
    <a class="button site-header__cta" href={cta.href}>{cta.label}</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    padding: var(--space-3) var(--space-3) 0;
    pointer-events: none;
    view-transition-name: site-header;
  }
  .site-header__pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: min(100%, var(--page));
    margin-inline: auto;
    min-height: 60px;
    padding: 6px 8px 6px var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--glass);
    border: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    transition:
      box-shadow 300ms var(--ease-out),
      width 450ms var(--ease-out);
  }
  :global([data-scrolled]) .site-header__pill {
    box-shadow: var(--shadow-lift);
  }
  @media (min-width: 760px) {
    :global([data-scrolled]) .site-header__pill {
      width: min(100%, 860px);
    }
  }
  .site-header__home {
    text-decoration: none;
    margin-right: auto;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    border-radius: var(--radius-pill);
  }
  .site-header__nav ul {
    display: flex;
    gap: 2px;
    padding: 0;
    list-style: none;
  }
  .site-header__nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 200ms var(--ease-out);
  }
  .site-header__nav a:hover {
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .site-header__nav a[aria-current='page'] {
    background: var(--ink);
    color: var(--surface);
  }
  .site-header__cta {
    min-height: 46px;
    padding: 0 var(--space-4);
    font-size: 15px;
    white-space: nowrap;
  }

  .theme-toggle {
    flex: none;
    display: grid;
    place-content: center;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--glow-strong);
    cursor: pointer;
    transition:
      background-color 200ms var(--ease-out),
      transform 450ms var(--ease-spring);
  }
  .theme-toggle:hover {
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .theme-toggle:active {
    transform: scale(0.9) rotate(-12deg);
  }
  /* Day: a sun. Night: a second circle slides across and leaves a crescent, the brand motif. */
  .theme-toggle__cut {
    transform: translate(18px, -18px);
    transition: transform 450ms var(--ease-out);
  }
  .theme-toggle__disc {
    transform-origin: 16px 16px;
    transition: transform 450ms var(--ease-out);
  }
  .theme-toggle__rays {
    transform-origin: 16px 16px;
    transition:
      transform 450ms var(--ease-out),
      opacity 300ms var(--ease-out);
  }
  :global([data-theme='dark']) .theme-toggle__cut {
    transform: translate(6px, -5px);
  }
  :global([data-theme='dark']) .theme-toggle__disc {
    transform: scale(1.45);
  }
  :global([data-theme='dark']) .theme-toggle__rays {
    transform: rotate(60deg) scale(0.4);
    opacity: 0;
  }

  @media (max-width: 759px) {
    .site-header__pill {
      padding-left: var(--space-3);
    }
    .site-header__nav {
      position: fixed;
      left: 50%;
      bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
      transform: translateX(-50%);
      max-width: calc(100vw - 2 * var(--space-3));
      padding: 5px;
      border-radius: var(--radius-pill);
      background: var(--glass);
      border: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
      backdrop-filter: blur(16px) saturate(1.4);
      -webkit-backdrop-filter: blur(16px) saturate(1.4);
      box-shadow: var(--shadow-lift);
      overflow-x: auto;
      view-transition-name: site-tabs;
    }
    .site-header__nav a {
      padding: 0 14px;
      font-size: 14px;
    }
    .site-header__cta {
      padding: 0 14px;
      font-size: 14px;
    }
  }
  @media (max-width: 379px) {
    .site-header__nav a {
      padding: 0 10px;
      font-size: 13px;
    }
  }
</style>
