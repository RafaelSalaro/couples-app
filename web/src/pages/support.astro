---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { supportFaq } from '../data/faq-pages';
import { faqSchema } from '../lib/schema';
---

<Base
  title="Support: help, contact and account deletion"
  description={`Help with ${site.name}: pairing, unlocking, subscriptions, exporting your data and deleting your account. Contact us and we reply within one working day.`}
  og="support"
  breadcrumbs={[{ name: 'Support', path: '/support/' }]}
  schema={[faqSchema(supportFaq)]}
>
  <section class="page-head">
    <div class="wrap">
      <h1>How can we help?</h1>
      <p class="lede">
        Answers to common questions are below. If yours isn't here, write to us. We aim to reply within 24 hours on
        weekdays.
      </p>
    </div>
  </section>

  <section class="wrap">
    <div class="grid grid--2">
      <div class="card contact" id="contact">
        <Icon name="mail" />
        <h2>Contact us</h2>
        <p>
          Email <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>. In the app, Settings → Support →
          Contact support fills in your app version for you, which helps us help you faster.
        </p>
      </div>
      <div class="card contact">
        <Icon name="shield-check" />
        <h2>Worried about your relationship?</h2>
        <p>
          If the app, or anything else, is being used to pressure or control you, please see our
          <a href="/safety/">safety page</a>. You can unpair at any time, on your own.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="help">
    <div class="wrap">
      <div class="section-head section-head--center">
        <h2>Common questions</h2>
      </div>
      <Faq items={supportFaq} />
    </div>
  </section>

  <section class="section section--sunken" id="delete-account">
    <div class="wrap prose">
      <h2>Delete your account</h2>
      <p>You can delete your account yourself, in the app, at any time.</p>
      <ol>
        <li>Open {site.name} and go to <strong>Settings</strong>.</li>
        <li>Tap <strong>Delete account</strong>.</li>
        <li>Read what will be removed, then confirm.</li>
      </ol>
      <h3>What happens</h3>
      <ul>
        <li>Your account is deleted and you are unpaired. Your partner gets a short, neutral notification.</li>
        <li>Your personal data is removed from our systems within 30 days, as backups roll off.</li>
        <li>
          <strong>Deleting your account does not cancel an Apple subscription.</strong> If you pay for premium, cancel
          it on your iPhone under Settings → your name → Subscriptions.
        </li>
      </ul>
      <h3>If you can't open the app</h3>
      <p>
        Email <a href={`mailto:${site.supportEmail}?subject=Delete%20my%20account`}>{site.supportEmail}</a> from the
        address you signed up with and ask us to delete your account. We'll confirm when it's done.
      </p>
      <h3>Before you go</h3>
      <p>
        You can download a copy of your data first: Settings → Export my data. And if you only want to stop sharing with
        your partner, unpairing keeps your account and your own protected time.
      </p>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .contact h2 {
    font-size: 1.5rem;
  }
  .contact :global(.icon) {
    color: var(--hearth);
  }
</style>
