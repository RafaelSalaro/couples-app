---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page isn't here. Let's get you back." noindex>
  <section class="section">
    <div class="wrap" style="max-width: 640px;">
      <span class="eyebrow">404</span>
      <h1>This page wandered off</h1>
      <p class="lede">Nothing lost. The home page knows the way.</p>
      <p style="margin-top: var(--space-5);"><a class="button" href="/">Back to home</a></p>
    </div>
  </section>
</Base>
